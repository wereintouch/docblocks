{
  "name": "docblocks-react-ui",
  "version": "0.0.0",
  "description": "React rendering + editing layer for docblocks: hooks, block renderers, caret/selection, keyboard, clipboard.",
  "type": "module",
  "license": "UNLICENSED",
  "files": [
    "dist",
    "styles.css",
    "theme.css"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./mermaid": {
      "types": "./dist/mermaid/index.d.mts",
      "import": "./dist/mermaid/index.mjs"
    },
    "./motion": {
      "types": "./dist/motion/index.d.mts",
      "import": "./dist/motion/index.mjs"
    },
    "./styles.css": "./styles.css",
    "./theme.css": "./theme.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "docblocks-core": "*",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "framer-motion": "^11.0.0 || ^12.0.0 || ^13.0.0 || ^14.0.0",
    "mermaid": "^12.0.0"
  },
  "peerDependenciesMeta": {
    "framer-motion": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.45.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "docblocks-core": "*",
    "framer-motion": "^14.1.0",
    "jsdom": "^30.1.2",
    "mermaid": "12.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
