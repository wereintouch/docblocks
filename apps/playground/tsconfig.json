{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // vite/client provides the ambient declaration for the CSS import.
    "types": ["node", "vite/client"],
    // Vite 8's native config loader imports the relay with a .ts extension.
    "allowImportingTsExtensions": true
  },
  "include": ["src", "server", "test", "vite.config.ts", "vitest.config.ts"]
}
